# Copy this file to .env and fill in real values. .env is gitignored — never
# commit it.

# --- Required ---

# Sales Intellect POS API token. Prod and preprod use different tokens
# (from different Sales Intellect accounts/environments) — set this to
# whichever one matches APP_ENV on this instance.
SI_API_TOKEN=your_si_token_here

# Anthropic API key, used headlessly by the Claude Agent SDK (no interactive
# `claude login` needed when this is set).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Optional: app behavior ---

# Which environment this deployment is. Set to "production" only on the prod
# instance's .env — it turns on the red "PRODUCTION" corner banner and a
# subtle red tint in the UI, so it's obvious when you're looking at the real
# account. Leave as "preprod" (or unset) everywhere else. This does NOT
# switch API keys itself — prod and preprod are two separate deployments,
# each with its own SI_API_TOKEN below.
APP_ENV=preprod

# Only used when APP_ENV=production: the URL of the preprod deployment, for
# the "Go to preprod" link in the production banner. Leave unset on preprod.
PREPROD_URL=

# Model used by the parsing agent.
CLAUDE_MODEL=claude-sonnet-5

# Where the Streamlit UI reaches the Flask backend. Leave as-is unless the
# backend is running somewhere other than this same host.
SI_BACKEND_URL=http://127.0.0.1:5050

# Per-tab feature flags (true/false).
SI_TAB_GOODS_RECEIVED=true
SI_TAB_PRODUCT_UPDATES=false
SI_TAB_BULK_UPLOAD=false

# SKIP REVIEW (GRN only): on by default (including when unset) — there's no
# read-items -> review -> confirm flow, just a single "Submit GRN" button
# that parses the paste and submits immediately if every item matched
# (exact or fuzzy). Only items with no match at all ("flags") are shown,
# and submission is blocked until every flag is fixed. Set to false for
# the full review table instead.
SI_GRN_SKIP_REVIEW=true

# --- Optional: networking (defaults are already correct for the deploy/ setup) ---

# Flask backend bind address/port. Keep on 127.0.0.1 — this app is meant to
# sit behind a reverse proxy / tunnel, never exposed directly.
FLASK_HOST=127.0.0.1
FLASK_PORT=5050
FLASK_DEBUG=false

# Gunicorn worker count and per-request timeout (seconds). The parsing agent
# can take a couple of minutes on a large paste, so this is set high.
FLASK_WORKERS=2
FLASK_TIMEOUT=900

# Streamlit UI port. Address is fixed to 127.0.0.1 in .streamlit/config.toml.
STREAMLIT_SERVER_PORT=8501
