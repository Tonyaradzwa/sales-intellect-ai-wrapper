[Unit]
Description=Sales Intellect POS - Streamlit UI
After=network.target sales-intellect-flask.service
Wants=sales-intellect-flask.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/app
EnvironmentFile=/home/ec2-user/app/.env
ExecStart=/home/ec2-user/app/.venv/bin/streamlit run app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
